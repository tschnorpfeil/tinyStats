#!/bin/sh
# tinyStats CLI
set -eu
task_data=${TINYSTATS_HOME:-"$HOME/.local/share/tinystats"}
task_apps=${TINYSTATS_APP_DIR:-"$HOME/Applications"}
task_app="$task_apps/tinyStats.app"
task_exe="$task_app/Contents/MacOS/tinyStats"
owned_pids() {
    ps -ax -o pid= -o comm= | while read -r task_pid task_comm; do
        [ "$task_comm" != "$task_exe" ] || printf '%s\n' "$task_pid"
    done
}
case "${1:-start}" in
    start)
        [ -d "$task_app" ] || { echo 'tinyStats is missing. Run install.sh.' >&2; exit 1; }
        if [ -z "$(owned_pids)" ]; then open "$task_app"; fi
        ;;
    stop)
        for task_pid in $(owned_pids); do kill -TERM "$task_pid" 2>/dev/null || true; done
        ;;
    status)
        task_pids=$(owned_pids)
        if [ -n "$task_pids" ]; then printf 'tinyStats is running (PID %s).\n' "$task_pids"; else echo 'tinyStats is not running.'; fi
        ;;
    version|--version|-v)
        [ -f "$task_app/Contents/Resources/version.txt" ] || { echo 'Version metadata is missing; run tinystats update.' >&2; exit 1; }
        cat "$task_app/Contents/Resources/version.txt"
        ;;
    update)
        [ -d "$task_data/source/.git" ] || { echo 'Managed source checkout is missing. Please reinstall.' >&2; exit 1; }
        exec "$task_data/source/install.sh" --update
        ;;
    help|--help|-h)
        echo 'tinystats [start|stop|status|version|update]'
        ;;
    *) echo 'Unknown command. Run tinystats help' >&2; exit 2 ;;
esac
